PORT=3000
JWT_SECRET=remplacer-par-une-valeur-aleatoire-de-64-caracteres
JWT_TTL=8h
DB_FILE=./data/marcheplus.db
# Démonstration (comptes, procédure AO-2026-014, partenaire SOTRAP). En production : SEED_DEMO=0, l'instance démarre
# vide avec un seul compte administrateur (ADMIN_EMAIL ; sans ADMIN_PASSWORD, mot de passe tiré et affiché une fois
# dans le journal du serveur) et le nom d'organisation ORG_NOM.
SEED_DEMO=1
# ADMIN_EMAIL=achats@votre-domaine
# ADMIN_NOM=Administrateur
# ADMIN_PASSWORD=
# ORG_NOM=Votre organisation
SEED_PASSWORD=Marche+2026!
SHOW_DEMO_ACCOUNTS=1
ALLOW_RESET=1
# Adresse publique (liens envoyés par courriel)
APP_URL=http://localhost:3000
# Plateforme multi-entreprises : un espace par entreprise, à son sous-domaine (bal.tenders.neuronestech.com).
# Vide : un seul client sur la base principale. En local : PLATEFORME_DOMAINE=localhost (bal.localhost:3000).
# PLATEFORME_DOMAINE=tenders.neuronestech.com
# Sous-domaine de l'installation existante, reprise comme premier espace :
# ESPACE_INITIAL=demo
# Ouverture des espaces : accord d'un opérateur dans la console (par défaut) ; « auto » = dès la confirmation du courriel.
# PLATEFORME_VALIDATION=auto
# Premier opérateur de la console (https://tenders.neuronestech.com/console) ; il en ajoute d'autres depuis la console.
# CONSOLE_EMAIL=
# CONSOLE_NOM=
# CONSOLE_MOT_DE_PASSE=
# Plafonds de stockage des pièces (Mo) : brouillon d'inscription sans compte, ensemble des brouillons d'un espace,
# pièces d'une fiche partenaire (versions archivées comprises) ; dépôts de pièces par compte et par heure.
# BROUILLON_MAX_MO=50
# BROUILLONS_MAX_MO=500
# PARTENAIRE_MAX_MO=200
# PIECES_PAR_HEURE=60
# IA de préparation du cahier des charges (import d'un document, rédaction à partir d'une idée) : clé d'API Anthropic
# (platform.claude.com). Sans clé, la carte « Préparer avec l'IA » indique que l'IA n'est pas configurée.
ANTHROPIC_API_KEY=
# IA_MODELE=claude-opus-5-5
# Demandes par compte et par heure (chaque demande a un coût)
# IA_PAR_HEURE=30
# Courriels par Microsoft 365 (voir README) : MAIL_MODE=graph pour envoyer réellement, simule sinon
MAIL_MODE=simule
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SENDER=

PORT=3000
JWT_SECRET=remplacer-par-une-valeur-aleatoire-de-64-caracteres
JWT_TTL=8h
DB_FILE=./data/marcheplus.db
# Démonstration (comptes, procédure AO-2026-014, partenaire SOTRAP). En production : SEED_DEMO=0, l'instance démarre
# vide avec un seul compte administrateur (ADMIN_EMAIL ; sans ADMIN_PASSWORD, mot de passe tiré et affiché une fois
# dans le journal du serveur) et le nom d'organisation ORG_NOM.
SEED_DEMO=1
# ADMIN_EMAIL=achats@votre-domaine
# ADMIN_NOM=Administrateur
# ADMIN_PASSWORD=
# ORG_NOM=Votre organisation
SEED_PASSWORD=Marche+2026!
SHOW_DEMO_ACCOUNTS=1
ALLOW_RESET=1
# Adresse publique (liens envoyés par courriel)
APP_URL=http://localhost:3000
# Courriels par Microsoft 365 (voir README) : MAIL_MODE=graph pour envoyer réellement, simule sinon
MAIL_MODE=simule
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SENDER=
